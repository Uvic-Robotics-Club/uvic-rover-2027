        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/Link_3.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="wrist_pitch_joint"
    type="revolute">
    <origin
      xyz="0.045 -0.00026286 -0.054499"
      rpy="2.9256 -1.566 1.5708" />
    <parent link="forearm" />
    <child link="wrist" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="1.0" />
  </joint>


  <link name="hand">
    <inertial>
      <origin
        xyz="-0.0331027805567119 -0.0084491238454061 0.000358215250377603"
        rpy="0 0 0" />
      <mass
        value="1.07420417469454" />
      <inertia
        ixx="0.000370038411474129"
        ixy="-1.30681604361726E-05"
        ixz="7.54293526547091E-06"
        iyy="0.00040250866371949"
        iyz="6.86484393222107E-07"
        izz="0.000382733996464899" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/Link_4.STL" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/Link_4.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="wrist_roll_joint"
    type="revolute">
    <origin
      xyz="-0.221 -0.017793 -0.027793"
      rpy="-1.5708 1.0013 -1.5708" />
    <parent link="wrist" />
    <child link="hand" />
    <axis xyz="1 0 0" />
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.0" />
  </joint>


  <link name="end_effector">
    <inertial>
      <origin
        xyz="-0.0922610708246211 0.000157474196861629 -5.12065819328177E-05"
        rpy="0 0 0" />
      <mass
        value="0.564191778913126" />
      <inertia
        ixx="0.00020367288080541"
        ixy="5.00199268323845E-06"
        ixz="1.64412556928948E-08"
        iyy="0.000410307679525273"
        iyz="-3.6650458101903E-08"
        izz="0.00036920922712019" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/Link_5.STL" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/Link_5.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="hand_joint"
    type="revolute">
    <origin
      xyz="-0.033 -0.0395 0.00013472"
      rpy="-1.5674 0.0034105 1.5708" />
    <parent link="hand" />
    <child link="end_effector" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="1.0" />
