<?xml version="1.0" encoding="utf-8"?>
<!--
  Rover Arm URDF — UVic Robotics 2026
  Originally exported from SolidWorks via SW2URDF exporter.

  Manual fixes applied:
  - Added world link and world_to_base fixed joint
  - Set <axis xyz="1 0 0"/> on all joints (rotation axis in local joint frame)
  - Set joint limits and effort/velocity values
-->
<robot name="Rover_Arm">

  <!-- Define materials once at the top -->
  <material name="silver">
    <color rgba="0.898 0.918 0.929 1" />
  </material>
  <material name="blue_grey">
    <color rgba="0.792 0.820 0.933 1" />
  </material>
  <material name="orange">
    <color rgba="0.910 0.443 0.031 1" />
  </material>
  <material name="dark_grey">
    <color rgba="0.251 0.251 0.251 1" />
  </material>
  
  <!-- Ensure Base Link loads correctly -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin
        xyz="0.000912089426587583 0.0508484956657282 3.91930361746801E-16"
        rpy="0 0 0" />
      <mass
        value="2.01423075446435" />
      <inertia
        ixx="0.00162095123596757"
        ixy="3.16191868202788E-06"
        ixz="3.08635636595603E-18"
        iyy="0.00165670509133979"
        iyz="-5.29878797886984E-20"
        izz="0.00166196281192181" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/base_link.STL" />
      </geometry>
      <material name="silver" /> 
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>


  <link name="turret">
    <inertial>
      <origin
        xyz="0.0410047539276393 0.0173048633261333 -0.00379587456015352"
        rpy="0 0 0" />
      <mass
        value="0.266350669323808" />
      <inertia
        ixx="0.000450831124849188"
        ixy="-9.49660798657449E-05"
        ixz="2.08311953814869E-05"
        iyy="0.000437884738411932"
        iyz="-1.03268486491131E-05"
        izz="0.000393065439217813" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/Rot_base.STL" />
      </geometry>
      <material name="silver" /> 
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/Rot_base.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="turret_joint"
    type="revolute">
    <origin
      xyz="0 0 0.007"
      rpy="1.5708 -1.5708 0" />
    <parent link="base_link" />
    <child link="turret" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="1.0" />
  </joint>


  <link name="upper_arm">
    <inertial>
      <origin
        xyz="-0.00963120390908834 -8.04609132619427E-09 -0.160297472582219"
        rpy="0 0 0" />
      <mass
        value="1.17664105126444" />
      <inertia
        ixx="0.0096970538423333"
        ixy="-6.47381347747972E-11"
        ixz="1.19273145527235E-08"
        iyy="0.00938667411029963"
        iyz="2.19883831648442E-09"
        izz="0.000665771761767255" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/link_1.STL" />
      </geometry>
      <material name="blue_grey" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/link_1.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="shoulder_joint"
    type="revolute">
    <origin
      xyz="0.0705 0.066421 -0.014571"
      rpy="1.5708 -0.21595 -1.5708" />
    <parent link="turret" />
    <child link="upper_arm" />
    <axis xyz="1 0 0" />
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.0" />
  </joint>


  <link name="forearm">
    <inertial>
      <origin
        xyz="0.0440605492670829 0.000447759552270756 -0.0211514340640124"
        rpy="0 0 0" />
      <mass
        value="1.19092211150625" />
      <inertia
        ixx="0.000576305054119571"
        ixy="-1.03848516030153E-05"
        ixz="4.74867876785011E-05"
        iyy="0.00054125812954335"
        iyz="1.61018288279126E-06"
        izz="0.000582168162384795" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/link_2.STL" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/link_2.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="elbow_joint"
    type="revolute">
    <origin
      xyz="0.007 0 -0.3206"
      rpy="0 0 0" />
    <parent link="upper_arm" />
    <child link="forearm" />
    <axis xyz="1 0 0" />
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.0" />
  </joint>


  <link
    name="wrist">
    <inertial>
      <origin
        xyz="-0.207236849076382 -0.0307266470363196 -0.0485642422686654"
        rpy="0 0 0" />
      <mass
        value="1.17148580234296" />
      <inertia
        ixx="0.00038109399371801"
        ixy="-2.30916267860668E-05"
        ixz="-2.19619017838529E-05"
        iyy="0.000511536223999207"
        iyz="4.86627127602619E-06"
        izz="0.000518019121252321" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_arm/meshes/Link_3.STL" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin
